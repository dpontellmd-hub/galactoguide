{
  "expo": {
    "name": "GalactoGuide",
    "slug": "galactoguide",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "galactoguide",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dyadhealthcollective.galactoguide",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.dyadhealthcollective.galactoguide",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C97C5D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://axxuefnkoxfifftjnuxo.supabase.co",
      "supabaseAnonKey": "sb_publishable_VzLT5EsSeWfKJVt94hlWfg_9oUZZv6t",
      "router": {},
      "eas": {
        "projectId": "ae2d9839-6726-427f-8b93-24406d04b3e7"
      }
    },
    "owner": "admolofto"
  }
}
