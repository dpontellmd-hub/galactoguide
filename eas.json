{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GALACTOGUIDE_NATIVE_BUILD": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "GALACTOGUIDE_NATIVE_BUILD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "GALACTOGUIDE_NATIVE_BUILD": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804115344"
      }
    }
  }
}
